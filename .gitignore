# Publication allowlist. Working media and research are excluded by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/build.ps1
!/src/
/src/*
!/src/*.cs
!/third_party/
/third_party/*
!/third_party/NOTICES.txt
!/third_party/dnglab-LGPL-2.1.txt
!/third_party/dnglab-reference.json
!/assets/
/assets/*
!/assets/RAWER.ico
!/assets/comic-0.6/
/assets/comic-0.6/*
!/assets/comic-0.6/source.png
!/assets/comic-0.6/compression.png
!/assets/comic-0.6/folder.png
!/assets/comic-0.6/results.png
!/research/
/research/*
!/research/dnglab-reference/
/research/dnglab-reference/*
!/research/dnglab-reference/bitreader.rs
!/research/dnglab-reference/dwt.rs
!/research/dnglab-reference/entropy.rs
!/research/dnglab-reference/header.rs
!/research/dnglab-reference/pi.rs

# Never commit media, local settings, credentials or build products.
**/.env
**/.env.*
**/settings.json
**/*credentials*
**/id_rsa*
**/id_ed25519*
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.R3D
**/*.r3d
**/*.RMD
**/*.rmd
**/*.mov
**/*.mp4
**/*.report.json
**/*.pdb
**/*.exe
**/*.dll
**/*.zip
**/*.log
**/.tests/
**/__pycache__/
**/.DS_Store
**/Thumbs.db
